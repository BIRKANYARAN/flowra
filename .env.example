# ── Supabase (REQUIRED) ────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL (REQUIRED in production) ──────────────────────────────────────────
# Used by the health check (/api/health) FX feed self-call and canonical URLs.
# In Vercel this is auto-set via VERCEL_URL, but set explicitly for custom domains.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Feature flags (OPTIONAL) ───────────────────────────────────────────────────
# Set to "true" ONLY in local/staging environments.
# Leave unset (or set to "false") in production to disable dangerous endpoints.
ENABLE_RESET=false
ENABLE_SEED=false
