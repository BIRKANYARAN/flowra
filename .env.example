# ═══════════════════════════════════════════════════════════════════════════════
# FLOWRA — Environment Variables Reference
# Copy this file to .env.local for local development.
# Set all variables in Vercel project settings for production.
#
# [REQUIRED] = app will not start without this
# [optional] = graceful fallback exists
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE  [REQUIRED]
# Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key — SECRET, server-side only, never expose to browser
# Used for: admin operations, cron jobs, GL backfill, health checks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION URL  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of your deployed application
# Used for: email links, proforma public share URLs, PDF generation
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app  OR  https://app.yourcompany.com
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Alias — used by health check route; set to same value as NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY  [REQUIRED in production]
# ─────────────────────────────────────────────────────────────────────────────

# Secret token to authenticate incoming cron job requests from Vercel
# Generate: openssl rand -hex 32
# Vercel cron routes send this as:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-secret-cron-token-here

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — RESEND  [optional — email features disabled if not set]
# Get API key: https://resend.com/api-keys
# Without this: alert digests and notification emails will not send.
# All financial features work normally without email.
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must be verified in your Resend account
RESEND_FROM_EMAIL=flowra@yourcompany.com

# Admin email to receive daily financial alert digest  [optional]
ADMIN_DIGEST_EMAIL=admin@yourcompany.com

# ─────────────────────────────────────────────────────────────────────────────
# AI FEATURES — ANTHROPIC  [optional — rule-based fallback always active]
# Without this: AI situation summaries use deterministic rule-based text.
# All financial calculations are unaffected — AI writes narrative only.
# Get key: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING  [optional]
# ─────────────────────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error
# Default: info (production), debug (development)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT / TESTING FLAGS  [dev/staging only — NEVER set in production]
# ─────────────────────────────────────────────────────────────────────────────

# Enable /api/seed to load demo data — WARNING: data injection risk
# Default: disabled (leave commented out in production)
# ENABLE_SEED=true

# Enable /api/reset to wipe all company data — WARNING: DESTRUCTIVE
# Default: disabled (leave commented out in production)
# ENABLE_RESET=true

# ─────────────────────────────────────────────────────────────────────────────
# AUTO-INJECTED BY VERCEL — do not set manually
# ─────────────────────────────────────────────────────────────────────────────

# Vercel injects the deployment URL automatically.
# Used as fallback for NEXT_PUBLIC_APP_URL when not set explicitly.
# VERCEL_URL=your-deployment-abc123.vercel.app

# Managed by Next.js/Vercel runtime. Do not set.
# NODE_ENV=production
